<Window x:Class="kursovaya.TeacherLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нагрузка преподавателя" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <DataGrid x:Name="TeacherLoadDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Course}" Width="*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="Часы" Binding="{Binding WeeklyLoad}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="TotalLoadText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>

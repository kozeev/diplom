<Window x:Class="kursovaya.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/Редактирование нагрузки"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="500" Height="461"
        Background="#FFFDFCE5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0 0 0 20" VerticalAlignment="Top">
            <Label Content="Преподаватель"/>
            <TextBox x:Name="TeacherBox" Margin="0,5"/>

            <Label Content="Предмет"/>
            <TextBox x:Name="SubjectBox" Margin="0,5"/>

            <Label Content="Группа"/>
            <TextBox x:Name="GroupBox" Margin="0,5"/>

            <Label Content="Часы по плану"/>
            <TextBox x:Name="PlanHoursBox" Margin="0,5"/>

            <Label Content="Часы по факту"/>
            <TextBox x:Name="FactHoursBox" Margin="0,5"/>

            <Label Content="Тип занятия"/>
            <ComboBox x:Name="TypeComboBox" Margin="0,5">
                <ComboBoxItem Content="Лекции"/>
                <ComboBoxItem Content="Практика"/>
                <ComboBoxItem Content="Лабораторные"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="5"
                    Background="#9253F9" Foreground="White" FontWeight="Bold"
                    Click="Save_Click"/>
            <Button Content="Отмена" Width="100" Margin="5"
                    Background="#9253F9" Foreground="White" FontWeight="Bold"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
